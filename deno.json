{
    "nodeModulesDir": "manual",
    "exclude": ["dist", "node_modules"],
    "fmt": {
        "exclude": ["package-lock.json"],
        "indentWidth": 4,
        "lineWidth": 100,
        "trailingCommas": "onlyMultiLine",
        "operatorPosition": "nextLine"
    },
    "lint": {
        "exclude": ["package-lock.json"],
        "plugins": []
    },
    "compilerOptions": {
        "lib": ["dom", "dom.iterable", "esnext"],
        "strict": true,
        "jsx": "react-jsx"
    }
}
