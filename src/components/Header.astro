---
import Logo from "./ui/Logo.svelte";
import Navigation from "./ui/Navigation.svelte";
import { headers } from "../lib/navigation.ts";
---

<header>
    <a href="/" aria-label="home" class="home">
        <Logo client:visible />
    </a>
    <Navigation links={headers} currentPath={Astro.url.pathname} client:load />
</header>

<style>
    header {
        display: flex;
        align-items: center;
        flex-shrink: 0;
        padding: var(--header-py) var(--document-margin);
    }

    /* make logo animation persists between page navigation to home  */
    .home {
        view-transition-name: logo;
    }
</style>
