---
import type { GetStaticPaths } from "astro";
import Layout from "../layouts/Layout.astro";
import Carousel from "../components/Carousel.astro";
import Pagination from "../components/ui/Pagination.svelte";
import Logo from "../components/ui/Logo.svelte";
import { fetchShops } from "../lib/api.ts";

export const getStaticPaths = (async ({ paginate }) => {
    const shops = await fetchShops();
    return paginate(shops, { pageSize: 10 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<Layout>
    <section class="hero">
        <header>
            <Logo width="240px" height="140px" client:visible />
            <h1>Ramen. . .</h1>
            <p>
                A compendium for those with a gluttonous appetite for world-famous
                Japanese cuisine.
            </p>
        </header>
    </section>
    <Carousel items={page.data} />
    <Pagination
        client:load
        count={page.total}
        perPage={page.size}
        page={page.currentPage}
        baseUrl=""
    />
</Layout>

<style>
    .hero {
        padding-left: var(--document-margin);
        padding-right: var(--document-margin);

        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .hero header {
        display: grid;
        justify-items: center;
        gap: 0.75rem;
        text-align: center;

        & p {
            max-width: 36rem;
        }
    }
</style>
