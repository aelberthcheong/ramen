---
import Layout from "../layouts/Layout.astro";

import Gunkanmaki from "../assets/icons/Gunkanmaki.svelte";
import SakeMaki from "../assets/icons/SakeMaki.svelte";
import KappaMaki from "../assets/icons/KappaMaki.svelte";

const teams = [
    { name: "Albert Cheong", image: Gunkanmaki, color: "var(--coral-02)" },
    { name: "Fendy", image: KappaMaki, color: "var(--moss-02)" },
    { name: "Laurencio Luckson", image: SakeMaki, color: "var(--wine-03)" },
];
---

<Layout 
    title="About"
    description="About the team and projects that make it happens"
>
    <article>
        <header>
            <h1>About</h1>
            <p>
                Ramen is a web app built as a submission for our computer science course. 
                Which we've also reused in our other courses e.g. in our web development course.
                In succinct it's our Hello World.
            </p>
            <p>
                It will be developed alongside our tenure here and would probably end by it aswell.
            </p>
        </header>
        <section>
            <h2>Team</h2>
                <div class="team">
                    {teams.map(({ name, image: Image, color }) => (
                        <div class="member">
                            <figure style={`background-color: ${color}`} aria-hidden="true">
                                <Image />
                            </figure>
                            <p>{name}</p>
                        </div>
                    ))}
                </div>
        </section>
        <section>
            <h2>Special Thanks</h2>
            <p>
                Thanks to the <a
                    href="https://github.com/yusukebe/ramen-api"
                    rel="noopener noreferrer"
                    target="_blank">Ramen API</a
                >&nbsp;
                project by Yusukebe and its contributors.
            </p>
        </section>
    </article>
</Layout>

<style>
    header,
    section {
        padding-inline: max(
            var(--document-margin),
            50vw - var(--content-regular) / 2
        );
    }

    article > * {
        margin-left: auto;
        margin-right: auto;
        width: 100%;
    }

    article > header > h1 {
        margin-bottom: clamp(1rem, 0.775rem + 0.75vw, 1.375rem);
    }

    .team {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(6rem, 1fr));
        gap: 1.5rem 1rem;
    }

    .member {
        display: grid;
        justify-items: center;
        gap: 0.75rem;
        text-align: center;
    }

    .member figure {
        margin: 0;
        width: 100%;
        max-width: 9rem;
        aspect-ratio: 1;
        border-radius: 50%;

        display: grid;
        place-items: center;
        padding: 10%;
        box-sizing: border-box;
        overflow: hidden;
        user-select: none;
    }

    .member figure :global(svg) {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }
</style>
