---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import Layout from "../../layouts/Layout.astro";
import { fetchShops, fetchAuthors } from "../../lib/api.ts";
import { cdn_image, cdn_srcset } from "../../lib/cdn-cgi";

export const getStaticPaths = (async () => {
    const shops = await fetchShops();

    // Each shop's photos usually share one author, and many shops share the
    // same author, so fetch each author only once (cache the promises).
    const authors = new Map<string, ReturnType<typeof fetchAuthors>>();
    const getAuthor = (id: string) => {
        if (!authors.has(id)) 
            authors.set(id, fetchAuthors(id));
        return authors.get(id)!;
    };

    return Promise.all(
        shops.map(async (shop) => {
            const authorId = shop.photos[0]?.authorId;
            const author = authorId ? (await getAuthor(authorId)).author : null;
 
            return {
                params: { shop: String(shop.id) },
                props: { shop, author },
            };
        }),
    );
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { shop, author } = Astro.props;

const title = `${shop.name} - ${shop.id}`;
---

<!-- TODO: use title for the description for now
 -->
<Layout title={title} description={title}>
    <aside>
        {shop.photos.map((photo, i) => (
            <figure>
                <img
                    src={cdn_image(photo.url, { width: 1200, height: 1200 })}
                    srcset={cdn_srcset(photo.url, [800, 1200])}
                    sizes="60vh"
                    width={photo.width}
                    height={photo.height}
                    alt={shop.name}
                    loading={i === 0 ? "eager" : "lazy"}
                    fetchpriority={i === 0 ? "high" : "auto"}
                    decoding="async"
                />
            </figure>
        ))}
    </aside>
    <article>
        <section>
            <header>
                <h1>{shop.name}</h1>
                <p>{shop.prefecture}</p>
            </header>
            {author && (
                <p>
                    <strong>Photos:</strong>
                    &nbsp;<a href={author.url} rel="noopener noreferrer" target="_blank">
                        {author.name}
                    </a>
                </p>
            )}
        </section>
        <!-- Reserved for the right-hand column (kept so the grid layout holds) -->
        <section></section>
    </article>
</Layout>

<style>
    aside {
        display: flex;
        /* 16px < ... > 24px */
        gap: clamp(1rem, 0.7rem + 1vw, 1.5rem);
 
        padding-inline: var(--document-margin);
        scroll-padding-inline: var(--document-margin);
 
        max-inline-size: 100%;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
    }
 
    aside > figure {
        flex: none;
        margin: 0;
    }
 
    aside > figure img {
        border-radius: var(--border-radius-md);
        width: auto;
        max-height: 45vh;
    }
 
    aside > figure figcaption {
        margin-top: 0.5rem;
        font-size: 0.875rem;
        opacity: 0.75;
    }
 
    article {
        display: grid;
        grid-template-areas:
            "left"
            "right";
        grid-template-columns: 1fr;
        gap: clamp(2rem, 1.4rem + 2vw, 3rem);
        padding-inline: var(--document-margin);
    }
 
    article > section:first-of-type {
        grid-area: left;
        align-self: start;
 
        & > header {
            margin-bottom: clamp(1rem, 0.775rem + 0.75vw, 1.375rem);
 
            & > h1 {
                margin-bottom: 4px;
            }
        }
    }
 
    article > section:last-of-type {
        display: grid;
        grid-area: right;
        grid-auto-rows: min-content;
        gap: 2rem;
 
        & > section {
            display: grid;
            gap: 1rem;
 
            & header {
                display: flex;
                align-items: center;
                gap: 0.875rem;
 
                & img {
                    min-width: 0;
                    width: auto;
                    height: 2.25rem;
                }
            }
        }
    }
 
    article ul > li {
        padding-block: 1rem;
 
        &:not(:last-of-type) {
            border-bottom: var(--border-width) solid var(--raisin);
        }
 
        &:first-of-type {
            padding-top: 0;
        }
 
        &:last-of-type {
            padding-bottom: 0;
        }
 
        & p {
            margin-block: 0;
        }
 
        & a {
            color: inherit;
            text-decoration: none;
 
            &:hover {
                text-decoration: underline;
            }
        }
    }
 
    @media (min-width: 768px) {
        aside > figure figcaption {
            font-size: 1rem;
        }
 
        article {
            grid-template-areas: "left right";
            grid-template-columns: 1fr 1fr;
        }
 
        article > section:last-of-type {
            gap: 3rem; /* between types of spots */
 
            & > section {
                gap: 1.5rem;
 
                & header {
                    gap: 1.125rem;
 
                    & img {
                        height: 2.75rem;
                    }
                }
            }
        }
 
        article ul > li {
            padding-block: 1.375rem;
 
            &:first-of-type {
                padding-top: 0;
            }
 
            &:last-of-type {
                padding-bottom: 0;
            }
        }
    }
 
    @media (min-width: 1280px) {
        /* Sticky intro column; scrolls internally if taller than the viewport. */
        article > section:first-of-type {
            position: sticky;
            top: 2rem;
            max-height: calc(100dvh - 2rem);
            overflow-y: auto;
        }
    }
</style>