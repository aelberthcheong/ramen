# https://caddyserver.com/docs/caddyfile
#
# Setup caddy to serve static pages, whenever route requests an invalid
# page would be served with 404.html instead
:80 {
    root * /srv
    encode zstd gzip

    handle /_astro/* {
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    handle {
        header Cache-Control "no-cache"
        try_files {path} {path}.html {path}/index.html
        file_server
    }

    handle_errors {
        rewrite * /404.html

        # handle_errors is its own route chain, so the site-level `encode`
        # above is NOT applied here. Without this, the 404 page is served
        # as is
        encode zstd gzip

        file_server
    }
}